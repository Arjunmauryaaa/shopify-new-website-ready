<article class="product-card">
  <a class="product-image" href="{{ product.url }}">
    {% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | image_tag: widths: '360, 540, 720, 900', sizes: '(min-width: 900px) 25vw, 50vw', loading: 'lazy', alt: product.featured_image.alt | default: product.title }}{% else %}<span class="image-placeholder">{{ product.title | escape }}</span>{% endif %}
  </a>
  <div class="product-meta"><a href="{{ product.url }}">{{ product.title | escape }}</a><span>{{ product.price | money }}</span></div>
  {% if product.compare_at_price > product.price %}<p class="sale-note">Sale</p>{% endif %}
</article>
