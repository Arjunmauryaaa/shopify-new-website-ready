{%- capture card_title -%}{% render 'product-short-title', product: product %}{%- endcapture -%}
{%- assign second_image = product.images[1] -%}
<article class="product-card">
  <div class="product-card__media">
    <a class="product-image" href="{{ product.url }}" aria-label="{{ card_title | strip | escape }}" tabindex="-1">
      {%- if product.featured_image -%}
        {{ product.featured_image | image_url: width: 900 | image_tag: widths: '360, 540, 720, 900', sizes: '(min-width: 900px) 25vw, 50vw', loading: 'lazy', alt: product.featured_image.alt | default: card_title, class: 'product-card__img' }}
        {%- if second_image -%}{{ second_image | image_url: width: 900 | image_tag: widths: '360, 540, 720, 900', sizes: '(min-width: 900px) 25vw, 50vw', loading: 'lazy', alt: '', class: 'product-card__img product-card__img--alt' }}{%- endif -%}
      {%- else -%}
        <span class="image-placeholder">{{ card_title }}</span>
      {%- endif -%}
      {%- if product.available == false -%}<span class="tag">Sold out</span>
      {%- elsif product.compare_at_price > product.price -%}<span class="tag tag--sale">Sale</span>{%- endif -%}
    </a>
    <button class="wish" type="button" data-wish="{{ product.handle }}" aria-pressed="false" aria-label="Save {{ card_title | strip | escape }}">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10Z"/></svg>
    </button>
    {%- if product.available and product.variants.size == 1 -%}
      <button class="quick-add" type="button" data-quick-add="{{ product.selected_or_first_available_variant.id }}">Quick add</button>
    {%- endif -%}
  </div>
  <div class="product-meta"><a href="{{ product.url }}">{{ card_title }}</a><span>{% if product.price_varies %}From {% endif %}{{ product.price | money }}{% if product.compare_at_price > product.price %} <s class="muted">{{ product.compare_at_price | money }}</s>{% endif %}</span></div>
  {%- for option in product.options_with_values -%}
    {%- assign option_name = option.name | downcase -%}
    {%- if option_name contains 'colo' and option.values.size > 1 -%}
      <p class="swatches" aria-label="{{ option.values.size }} colours">
        {%- for value in option.values limit: 5 -%}
          {%- if value.swatch.color -%}<span class="swatch" style="background:{{ value.swatch.color }}" title="{{ value | escape }}"></span>{%- endif -%}
        {%- endfor -%}
        {%- if option.values.size > 5 -%}<span class="muted small">+{{ option.values.size | minus: 5 }}</span>{%- endif -%}
      </p>
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
</article>
