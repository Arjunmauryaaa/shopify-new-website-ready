{%- comment -%} Recommended product on the ad checkout page. assets/express.js reads the data-* attributes to add it to the order. {%- endcomment -%}
{%- capture card_title -%}{% render 'product-short-title', product: product %}{%- endcapture -%}
{%- assign card_title = card_title | strip -%}
{%- assign v = product.selected_or_first_available_variant -%}
{%- assign auto_pct_list = "15,20,25,30,18,22,28,12,16,24,26,14,19,27,21" | split: "," -%}
{%- assign auto_pct_idx = product.id | modulo: auto_pct_list.size -%}
{%- assign auto_markup = auto_pct_list[auto_pct_idx] | plus: 0 -%}
{%- assign auto_multiplier = 100 | plus: auto_markup -%}
{%- assign up_compare = v.compare_at_price -%}
{%- if up_compare == blank or up_compare <= v.price -%}
  {%- assign up_compare = v.price | times: auto_multiplier | divided_by: 10000 | times: 100 -%}
{%- endif -%}
<article class="up" data-up data-title="{{ card_title | escape }}" data-img="{% if product.featured_image %}{{ product.featured_image | image_url: width: 160 }}{% endif %}"
  data-variant="{{ v.id }}" data-price="{{ v.price }}" data-compare="{{ up_compare }}" data-label="{% unless product.has_only_default_variant %}{{ v.title | escape }}{% endunless %}">
  <a class="up__img" href="{{ product.url }}?view=express" tabindex="-1" aria-hidden="true">
    {%- if product.featured_image -%}{{ product.featured_image | image_url: width: 600 | image_tag: widths: '240, 360, 480, 600', sizes: '(min-width: 1000px) 18vw, 44vw', loading: 'lazy', alt: '' }}{%- else -%}<span class="image-placeholder">{{ card_title }}</span>{%- endif -%}
  </a>
  <div class="up__body">
    <a class="up__title" href="{{ product.url }}?view=express">{{ card_title }}</a>
    {%- unless product.has_only_default_variant -%}
      <select data-up-variant aria-label="Option for {{ card_title | escape }}">
        {%- for variant in product.variants -%}
          {%- assign opt_var_compare = variant.compare_at_price -%}
          {%- if opt_var_compare == blank or opt_var_compare <= variant.price -%}
            {%- assign opt_var_compare = variant.price | times: auto_multiplier | divided_by: 10000 | times: 100 -%}
          {%- endif -%}
          <option value="{{ variant.id }}" data-price="{{ variant.price }}" data-compare="{{ opt_var_compare }}" data-label="{{ variant.title | escape }}"{% if variant == v %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>{{ variant.title | escape }}{% unless variant.available %} - Sold out{% endunless %}</option>
        {%- endfor -%}
      </select>
    {%- endunless -%}
    <span class="up__price"><span data-up-price>{{ v.price | money }}</span><s data-up-compare>{{ up_compare | money }}</s></span>
  </div>
  <button type="button" class="up__add" data-up-add aria-pressed="false"{% unless v.available %} disabled{% endunless %}>{% if v.available %}Add to my order{% else %}Sold out{% endif %}</button>
</article>
