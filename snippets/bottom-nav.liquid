{%- comment -%} Phone-only quick navigation. Hidden at wider widths by enhance.css. {%- endcomment -%}
<nav class="bottom-nav" aria-label="Quick navigation">
  <a href="{{ routes.root_url }}"{% if template.name == 'index' %} aria-current="page"{% endif %}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11 12 4l8 7v9h-5v-6H9v6H4v-9Z"/></svg><span>Home</span>
  </a>
  <a href="{{ routes.all_products_collection_url }}"{% if template.name == 'collection' %} aria-current="page"{% endif %}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="6.5" height="6.5"/><rect x="13.5" y="4" width="6.5" height="6.5"/><rect x="4" y="13.5" width="6.5" height="6.5"/><rect x="13.5" y="13.5" width="6.5" height="6.5"/></svg><span>Shop</span>
  </a>
  <button type="button" data-search-open aria-haspopup="dialog">
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.5 4.5"/></svg><span>Search</span>
  </button>
  {%- comment -%} Locale-safe link to the "Saved" page: /cart becomes /pages/saved (and /fr/cart becomes /fr/pages/saved). {%- endcomment -%}
  <a href="{{ routes.cart_url | replace: 'cart', 'pages/saved' }}">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10Z"/></svg><span>Saved <i data-wish-count></i></span>
  </a>
  <button type="button" data-cart-open aria-haspopup="dialog" aria-label="Open bag, {{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %}">
    <span class="bottom-nav__bag"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 8h14l-1 12H6L5 8Z"/><path d="M9 8V6.5a3 3 0 0 1 6 0V8"/></svg><b data-cart-badge{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</b></span><span aria-hidden="true">Bag</span>
  </button>
</nav>
