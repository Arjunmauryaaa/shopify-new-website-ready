<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.background }}">
    <script>try{if(localStorage.getItem('arjunta-theme')==='dark'){document.documentElement.dataset.theme='dark';document.querySelector('meta[name="theme-color"]').content='#141a17'}}catch(e){}</script>
    <link rel="canonical" href="{{ canonical_url }}">
    {% assign storefront_name = settings.site_name | default: shop.name %}
    <title>{{ page_title }}{% if current_tags %} - {{ current_tags | join: ', ' }}{% endif %}{% unless page_title contains storefront_name %} - {{ storefront_name }}{% endunless %}</title>
    {% if page_description != blank %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
    {% render 'seo-meta' %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=DM+Sans:wght@400;500;600;700&display=swap">
    {{ content_for_header }}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ 'home.css' | asset_url | stylesheet_tag }}
    {{ 'media.css' | asset_url | stylesheet_tag }}
    {{ 'theme-mode.css' | asset_url | stylesheet_tag }}
    {{ 'enhance.css' | asset_url | stylesheet_tag }}
    {{ 'polish.css' | asset_url | stylesheet_tag }}
    {{ 'premium.css' | asset_url | stylesheet_tag }}
    {{ 'wellness.css' | asset_url | stylesheet_tag }}
    <script>
      window.themeConfig = {
        currency: {{ cart.currency.iso_code | json }},
        locale: {{ request.locale.iso_code | json }},
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          cartUpdate: {{ routes.cart_update_url | json }},
          search: {{ routes.search_url | json }},
          suggest: {{ routes.predictive_search_url | json }},
          recommendations: {{ routes.product_recommendations_url | json }}
        }
      };
    </script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
    <script src="{{ 'enhance.js' | asset_url }}" defer></script>
    <script src="{{ 'wellness.js' | asset_url }}" defer></script>
    <style>:root{--bg:{{ settings.background }};--text:{{ settings.text }};--muted:{{ settings.muted }};--line:{{ settings.line }}}</style>
  </head>
  {%- assign express_page = false -%}{%- if template.suffix == 'express' -%}{%- assign express_page = true -%}{%- endif -%}
  <body class="template-{{ template.name }}{% if express_page %} is-express{% endif %}">
    <a class="skip-link" href="#MainContent">Skip to content</a>
    {%- comment -%} Ad landing pages (product.express) drop the site chrome so nothing pulls the shopper away from paying. {%- endcomment -%}
    {% unless express_page %}{% sections 'header-group' %}{% endunless %}
    <main id="MainContent" role="main">{{ content_for_layout }}</main>
    {% unless express_page %}
      {% sections 'footer-group' %}
      {% section 'cart-drawer' %}
      {% render 'search-dialog' %}
      {% render 'bottom-nav' %}
    {% endunless %}
    <div class="visually-hidden" role="status" aria-live="polite" data-announce></div>
  </body>
</html>
