<section class="es-hero">
  <div class="es-hero__copy">
    <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h1>{{ section.settings.heading | escape }}</h1>
    <p class="es-hero__body">{{ section.settings.body | escape }}</p>
    <div class="es-hero__actions">
      <a class="button button-dark" href="{{ section.settings.main_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>
      {% if section.settings.secondary_button_label != blank %}<a class="button button-outline" href="{{ section.settings.secondary_link | default: routes.all_products_collection_url }}">{{ section.settings.secondary_button_label | escape }}</a>{% endif %}
    </div>
    <ul class="es-hero__points">
      {% if section.settings.point_1 != blank %}<li>{{ section.settings.point_1 | escape }}</li>{% endif %}
      {% if section.settings.point_2 != blank %}<li>{{ section.settings.point_2 | escape }}</li>{% endif %}
      {% if section.settings.point_3 != blank %}<li>{{ section.settings.point_3 | escape }}</li>{% endif %}
    </ul>
  </div>
  <div class="es-hero__media">
    <a class="es-hero__tile es-hero__tile--main" href="{{ section.settings.main_link | default: routes.all_products_collection_url }}">
      {% if section.settings.main_image != blank %}{{ section.settings.main_image | image_url: width: 1400 | image_tag: widths: '600, 900, 1200, 1400', sizes: '(min-width: 900px) 32vw, 90vw', loading: 'eager' }}
      {% else %}<img src="{{ 'es-knit-stripes.jpg' | asset_url }}" width="1100" height="1443" alt="Striped knit polo and soft layers on a wooden rail" loading="eager">{% endif %}
      <span class="es-hero__tag">{{ section.settings.caption | escape }}</span>
    </a>
    <a class="es-hero__tile es-hero__tile--a" href="{{ section.settings.secondary_link | default: routes.all_products_collection_url }}">
      {% if section.settings.secondary_image != blank %}{{ section.settings.secondary_image | image_url: width: 1000 | image_tag: widths: '400, 700, 1000', sizes: '(min-width: 900px) 26vw, 45vw', loading: 'eager' }}
      {% else %}<img src="{{ 'es-floral-bloomer.jpg' | asset_url }}" width="1200" height="1068" alt="Floral muslin baby bloomers" loading="eager">{% endif %}
      <span class="es-hero__tag">{{ section.settings.secondary_caption | escape }}</span>
    </a>
    <a class="es-hero__tile es-hero__tile--b" href="{{ section.settings.main_link | default: routes.all_products_collection_url }}">
      {% if section.settings.third_image != blank %}{{ section.settings.third_image | image_url: width: 1000 | image_tag: widths: '400, 700, 1000', sizes: '(min-width: 900px) 26vw, 45vw', loading: 'eager' }}
      {% else %}<img src="{{ 'es-teddy-jacket.jpg' | asset_url }}" width="1000" height="1635" alt="Soft fleece hooded jacket with a knitted teddy" loading="eager">{% endif %}
    </a>
  </div>
</section>
{% schema %}{"name":"Editorial hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"New collection"},{"type":"text","id":"heading","label":"Heading","default":"Soft, simple clothes for little ones."},{"type":"textarea","id":"body","label":"Text","default":"Comfortable everyday essentials in calm, neutral tones for babies, designed to be worn, washed and loved."},{"type":"text","id":"button_label","label":"Button label","default":"Shop the collection"},{"type":"url","id":"main_link","label":"Button link"},{"type":"text","id":"secondary_button_label","label":"Second button label","default":"New arrivals"},{"type":"url","id":"secondary_link","label":"Second button and small image link"},{"type":"text","id":"point_1","label":"Highlight 1","default":"Free shipping over Rs. 2,000"},{"type":"text","id":"point_2","label":"Highlight 2","default":"Easy 15-day returns"},{"type":"text","id":"point_3","label":"Highlight 3","default":"Secure checkout"},{"type":"image_picker","id":"main_image","label":"Large image"},{"type":"text","id":"caption","label":"Large image label","default":"Knitwear"},{"type":"image_picker","id":"secondary_image","label":"Small image 1"},{"type":"text","id":"secondary_caption","label":"Small image 1 label","default":"Bodysuits"},{"type":"image_picker","id":"third_image","label":"Small image 2"}]}
{% endschema %}
