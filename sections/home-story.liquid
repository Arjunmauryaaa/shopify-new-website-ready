<section class="home-story">
  <div class="home-story__media">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1600 | image_tag: class: 'home-story__image', widths: '700, 1000, 1400, 1600', sizes: '(min-width: 900px) 50vw, 100vw', loading: 'lazy' }}{% else %}<img class="home-story__image" src="{{ 'es-rack-wide.jpg' | asset_url }}" width="2200" height="1091" alt="Neutral baby clothes hanging on a wooden rail" loading="lazy">{% endif %}</div>
  <div class="home-story__copy"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.body | escape }}</p><a class="button button-dark" href="{{ section.settings.link | default: routes.root_url }}">{{ section.settings.link_label | escape }}</a></div>
</section>
{% schema %}{"name":"Campaign story","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Our story"},{"type":"text","id":"heading","label":"Heading","default":"Made to be lived in."},{"type":"textarea","id":"body","label":"Text","default":"Babies grow fast, so we focus on pieces that feel soft, wash well and go with everything. Calm colours, simple shapes and details that are easy on little ones."},{"type":"url","id":"link","label":"Link"},{"type":"text","id":"link_label","label":"Link label","default":"Discover the story"}]}
{% endschema %}
