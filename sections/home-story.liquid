<section class="home-story">
  {% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 2200 | image_tag: class: 'home-story__image', widths: '900, 1400, 1800, 2200', sizes: '100vw', loading: 'lazy' }}{% else %}<div class="campaign-placeholder"></div>{% endif %}
  <div class="home-story__copy"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.body | escape }}</p><a class="text-link" href="{{ section.settings.link | default: routes.root_url }}">{{ section.settings.link_label | escape }}</a></div>
</section>
{% schema %}{"name":"Campaign story","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Campaign"},{"type":"text","id":"heading","label":"Heading","default":"Made to be lived in."},{"type":"textarea","id":"body","label":"Text","default":"Thoughtful pieces for everyday life."},{"type":"url","id":"link","label":"Link"},{"type":"text","id":"link_label","label":"Link label","default":"Discover the story"}]}
{% endschema %}
