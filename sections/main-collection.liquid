<section class="page-wrap">
  <header class="page-heading"><p class="eyebrow">The collection</p><h1>{{ collection.title | escape }}</h1>{% if collection.description != blank %}<div class="rte">{{ collection.description }}</div>{% endif %}</header>
  {% paginate collection.products by 16 %}
    <div class="collection-toolbar"><span>{{ collection.products_count }} pieces</span><form method="get"><label for="SortBy">Sort by</label><select id="SortBy" name="sort_by" onchange="this.form.submit()">{% assign sort_by = collection.sort_by | default: collection.default_sort_by %}{% for option in collection.sort_options %}<option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>{% endfor %}</select></form></div>
    {% if collection.products.size > 0 %}<div class="product-grid">{% for product in collection.products %}{% render 'product-card', product: product %}{% endfor %}</div>{% else %}<p class="empty-note">There are no products in this collection yet.</p>{% endif %}
    {% if paginate.pages > 1 %}<nav class="pagination" aria-label="Pagination">{{ paginate | default_pagination }}</nav>{% endif %}
  {% endpaginate %}
</section>
{% schema %}{"name":"Collection products","settings":[]}{% endschema %}
