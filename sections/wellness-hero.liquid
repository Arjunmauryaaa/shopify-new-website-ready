{%- comment -%}
  Home hero for a health & personal care store. Accepts a photo or a short looping video; without either it shows a soft illustration so the page never looks empty.
{%- endcomment -%}
{%- assign cta_link = section.settings.main_link | default: routes.all_products_collection_url -%}
<section class="wh-hero">
  <div class="wh-hero__inner">
    <div class="wh-hero__copy">
      {%- if section.settings.eyebrow != blank -%}<span class="pill">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
      <h1>{{ section.settings.heading | strip_html | escape }}</h1>
      <p class="wh-hero__body">{{ section.settings.body | escape }}</p>
      <div class="wh-hero__actions">
        <a class="button button-dark" href="{{ cta_link }}">{{ section.settings.button_label | escape }}</a>
        {%- if section.settings.secondary_button_label != blank -%}<a class="button button-outline" href="{{ section.settings.secondary_link | default: routes.all_products_collection_url }}">{{ section.settings.secondary_button_label | escape }}</a>{%- endif -%}
      </div>
      <ul class="wh-hero__points">
        {%- if section.settings.point_1 != blank -%}<li>{{ section.settings.point_1 | escape }}</li>{%- endif -%}
        {%- if section.settings.point_2 != blank -%}<li>{{ section.settings.point_2 | escape }}</li>{%- endif -%}
        {%- if section.settings.point_3 != blank -%}<li>{{ section.settings.point_3 | escape }}</li>{%- endif -%}
      </ul>
    </div>
    <div class="wh-hero__stage">
      <div class="wh-hero__frame">
        {%- if section.settings.video != blank -%}
          {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, image_size: '1200x1400', preload: 'metadata' }}
        {%- elsif section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1400 | image_tag: widths: '500, 800, 1100, 1400', sizes: '(min-width: 1000px) 46vw, 92vw', loading: 'eager', fetchpriority: 'high', alt: section.settings.image.alt | default: section.settings.eyebrow }}
        {%- else -%}
          <img src="{{ 'wh-hero.jpg' | asset_url }}" width="1200" height="1400" alt="Dummy health and personal care products" loading="eager" fetchpriority="high">
        {%- endif -%}
      </div>
      {%- if section.settings.chip_1_title != blank -%}
        <div class="wh-chip wh-chip--a"><span class="wh-chip__icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 5 6v5.5c0 4.4 3 7.5 7 9.5 4-2 7-5.1 7-9.5V6l-7-3Z"/><path d="m9 12 2 2 4-4.5"/></svg></span><span>{{ section.settings.chip_1_title | escape }}<small>{{ section.settings.chip_1_text | escape }}</small></span></div>
      {%- endif -%}
      {%- if section.settings.chip_2_title != blank -%}
        <div class="wh-chip wh-chip--b"><span class="wh-chip__icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-7.5-4.6-7.5-10A4.3 4.3 0 0 1 12 7.4 4.3 4.3 0 0 1 19.5 10c0 5.4-7.5 10-7.5 10Z"/></svg></span><span>{{ section.settings.chip_2_title | escape }}<small>{{ section.settings.chip_2_text | escape }}</small></span></div>
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Wellness hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Badge", "default": "Health & personal care" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Everyday care, made gentle." },
    { "type": "textarea", "id": "body", "label": "Text", "default": "Thoughtfully chosen health and personal care essentials for a calmer, simpler daily routine." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "main_link", "label": "Button link" },
    { "type": "text", "id": "secondary_button_label", "label": "Second button label", "default": "Best sellers" },
    { "type": "url", "id": "secondary_link", "label": "Second button link" },
    { "type": "text", "id": "point_1", "label": "Highlight 1", "default": "Secure payments" },
    { "type": "text", "id": "point_2", "label": "Highlight 2", "default": "Easy returns" },
    { "type": "text", "id": "point_3", "label": "Highlight 3", "default": "Quality-checked products" },
    { "type": "header", "content": "Photo or video" },
    { "type": "image_picker", "id": "image", "label": "Hero photo", "info": "Portrait or square, at least 1200px wide." },
    { "type": "video", "id": "video", "label": "Hero video (optional)", "info": "Short, silent loop. Replaces the photo." },
    { "type": "header", "content": "Floating labels" },
    { "type": "text", "id": "chip_1_title", "label": "Label 1 title", "default": "Quality checked" },
    { "type": "text", "id": "chip_1_text", "label": "Label 1 text", "default": "Every product, every batch" },
    { "type": "text", "id": "chip_2_title", "label": "Label 2 title", "default": "Made for daily care" },
    { "type": "text", "id": "chip_2_text", "label": "Label 2 text", "default": "Simple, gentle routines" }
  ],
  "presets": [{ "name": "Wellness hero" }]
}
{% endschema %}
