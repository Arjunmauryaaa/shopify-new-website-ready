<section class="section-wrap">
  <div class="section-heading"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.title | escape }}</h2></div>{% if section.settings.collection != blank %}<a class="text-link" href="{{ section.settings.collection.url }}">View collection</a>{% endif %}</div>
  {% if section.settings.collection != blank and section.settings.collection.products_count > 0 %}
    <div class="product-grid">{% for product in section.settings.collection.products limit: section.settings.limit %}{% render 'product-card', product: product %}{% endfor %}</div>
  {% else %}<p class="empty-note">Products will appear here when they are added to this collection.</p>{% endif %}
</section>
{% schema %}
{"name":"Featured collection","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"A considered edit"},{"type":"text","id":"title","label":"Title","default":"Selected for you"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"limit","label":"Products to show","min":2,"max":8,"step":2,"default":4}]}
{% endschema %}
