<section class="section-wrap">
  <div class="section-heading"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.title | escape }}</h2></div>
    <div class="section-heading__side">{% if section.settings.collection != blank %}<a class="text-link" href="{{ section.settings.collection.url }}">View all</a>{% endif %}
    {% if section.settings.carousel %}<div class="carousel__nav" data-carousel-nav><button class="carousel__btn" type="button" data-carousel-prev aria-label="Previous products">&larr;</button><button class="carousel__btn" type="button" data-carousel-next aria-label="Next products">&rarr;</button></div>{% endif %}</div></div>
  {% if section.settings.collection != blank and section.settings.collection.products_count > 0 %}
    <div class="carousel"><div class="product-grid{% if section.settings.carousel %} product-grid--carousel{% endif %}"{% if section.settings.carousel %} data-carousel{% endif %}>{% for product in section.settings.collection.products limit: section.settings.limit %}{% render 'product-card', product: product %}{% endfor %}</div></div>
  {% else %}<p class="empty-note">Products will appear here when they are added to this collection.</p>{% endif %}
</section>
{% schema %}
{"name":"Featured collection","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"A considered edit"},{"type":"text","id":"title","label":"Title","default":"Selected for you"},{"type":"collection","id":"collection","label":"Collection"},{"type":"checkbox","id":"carousel","label":"Scrolling carousel","default":false},{"type":"range","id":"limit","label":"Products to show","min":2,"max":8,"step":2,"default":4}]}
{% endschema %}
