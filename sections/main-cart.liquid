<section class="page-wrap cart-page"><header class="page-heading"><p class="eyebrow">Your selection</p><h1>Shopping bag</h1></header>
  {% if cart.item_count == 0 %}<div class="empty-note"><p>Your bag is currently empty.</p><a class="text-link" href="{{ routes.all_products_collection_url }}">Continue shopping</a></div>
  {% else %}<form action="{{ routes.cart_url }}" method="post" novalidate><div class="cart-items">{% for item in cart.items %}<article class="cart-item">{% if item.image %}<a href="{{ item.url }}">{{ item.image | image_url: width: 320 | image_tag: width: 120, alt: item.image.alt | default: item.product.title }}</a>{% endif %}<div class="cart-item__details"><a class="cart-item__title" href="{{ item.url }}">{% render 'product-short-title', product: item.product %}</a>{% unless item.product.has_only_default_variant %}<p class="muted">{{ item.variant.title }}</p>{% endunless %}<label for="Quantity-{{ item.key }}">Quantity</label><input id="Quantity-{{ item.key }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0"><a class="cart-item__remove" href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0">Remove</a></div><strong>{{ item.final_line_price | money }}</strong></article>{% endfor %}</div>
    <div class="cart-total"><p>Subtotal <strong>{{ cart.total_price | money }}</strong></p><label for="CartPageNote">Order note or gift message</label><textarea id="CartPageNote" name="note" rows="3" maxlength="500" placeholder="Optional">{{ cart.note }}</textarea><p class="product-payment-note">Shipping and available payment methods are shown at checkout.</p><button class="button button-dark" type="submit" name="checkout">Continue to secure checkout</button>{% if additional_checkout_buttons %}<div class="cart-express">{{ content_for_additional_checkout_buttons }}</div>{% endif %}<button class="button button-outline" type="submit" name="update">Update bag</button></div></form>{% endif %}
</section>
{% schema %}{"name":"Shopping cart","settings":[]}{% endschema %}
