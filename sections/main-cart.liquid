<section class="page-wrap cart-page"><header class="page-heading"><p class="eyebrow">Your selection</p><h1>Shopping bag</h1></header>
  {% if cart.item_count == 0 %}<div class="empty-note"><p>Your bag is currently empty.</p><a class="text-link" href="{{ routes.all_products_collection_url }}">Continue shopping</a></div>
  {% else %}<form action="{{ routes.cart_url }}" method="post" novalidate><div class="cart-items">{% for item in cart.items %}<article class="cart-item">{% if item.image %}<a href="{{ item.url }}">{{ item.image | image_url: width: 240 | image_tag: width: 120, alt: item.title }}</a>{% endif %}<div><a href="{{ item.url }}">{{ item.product.title | escape }}</a>{% unless item.product.has_only_default_variant %}<p class="muted">{{ item.variant.title }}</p>{% endunless %}<label for="Quantity-{{ item.key }}">Quantity</label><input id="Quantity-{{ item.key }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0"></div><strong>{{ item.final_line_price | money }}</strong></article>{% endfor %}</div>
    <div class="cart-total"><label for="CartNote">Order note</label><textarea id="CartNote" name="note">{{ cart.note }}</textarea><p>Subtotal <strong>{{ cart.total_price | money }}</strong></p><button class="button button-outline" type="submit" name="update">Update bag</button><button class="button button-dark" type="submit" name="checkout">Checkout</button></div></form>{% endif %}
</section>
{% schema %}{"name":"Shopping cart","settings":[]}{% endschema %}
