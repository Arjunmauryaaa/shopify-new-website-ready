{% assign journal = blogs[section.settings.blog] %}
{% if journal != blank and journal.articles_count > 0 %}<section class="journal-preview"><div class="section-heading"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.title | escape }}</h2></div><a class="text-link" href="{{ journal.url }}">{{ section.settings.link_label | escape }}</a></div><div class="journal-preview__grid">{% for article in journal.articles limit: 3 %}<a class="journal-preview__card" href="{{ article.url }}">{% if article.image %}{{ article.image | image_url: width: 900 | image_tag: widths: '360, 600, 900', sizes: '(min-width: 900px) 33vw, 100vw', loading: 'lazy', alt: article.image.alt | default: article.title }}{% else %}<span class="campaign-placeholder">{{ article.title | escape }}</span>{% endif %}<p class="eyebrow">{{ article.published_at | time_tag: format: 'date' }}</p><h3>{{ article.title | escape }}</h3></a>{% endfor %}</div></section>{% endif %}
{% schema %}{"name":"Journal preview","settings":[{"type":"blog","id":"blog","label":"Blog"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Journal"},{"type":"text","id":"title","label":"Title","default":"Notes from the collection"},{"type":"text","id":"link_label","label":"Link label","default":"All stories"}]}
{% endschema %}
