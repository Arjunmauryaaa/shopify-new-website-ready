<section class="page-wrap"><header class="page-heading"><p class="eyebrow">Discover</p><h1>Search</h1></header><form action="{{ routes.search_url }}" method="get" role="search" class="search-form"><label for="SearchInput">Search products and pages</label><div><input id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="What are you looking for?"><button class="button button-dark" type="submit">Search</button></div></form>
  {% if search.performed %}<h2 class="results-title">Results for “{{ search.terms | escape }}”</h2>{% paginate search.results by 16 %}<div class="product-grid">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', product: item %}{% else %}<article class="search-page-result"><a href="{{ item.url }}"><span class="eyebrow">{{ item.object_type }}</span><h3>{{ item.title | escape }}</h3></a></article>{% endif %}{% else %}<p class="empty-note">No results found. Try another search.</p>{% endfor %}</div>{% if paginate.pages > 1 %}<nav class="pagination">{{ paginate | default_pagination }}</nav>{% endif %}{% endpaginate %}{% endif %}
</section>
{% schema %}{"name":"Search results","settings":[]}{% endschema %}
