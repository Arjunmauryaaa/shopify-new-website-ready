<article class="page-wrap article-page"><header class="page-heading"><p class="eyebrow">{{ blog.title | link_to: blog.url }}</p><h1>{{ article.title | escape }}</h1><p class="muted">{{ article.published_at | time_tag: format: 'date' }}</p></header>{% if article.image %}{{ article.image | image_url: width: 1800 | image_tag: class: 'article-image', widths: '700, 1100, 1500, 1800', loading: 'eager', alt: article.image.alt | default: article.title }}{% endif %}<div class="rte article-content">{{ article.content }}</div></article>
{% schema %}{"name":"Article","settings":[]}{% endschema %}
