{% if section.settings.announcement != blank %}<div class="announcement-bar" role="region" aria-label="Announcement">{% if section.settings.announcement_link != blank %}<a href="{{ section.settings.announcement_link }}">{{ section.settings.announcement }}</a>{% else %}<p>{{ section.settings.announcement }}</p>{% endif %}</div>{% endif %}
<header class="site-header">
  <div class="header-inner">
    <nav class="desktop-nav" aria-label="Main menu">
      {% for link in section.settings.menu.links %}<a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>{% endfor %}
    </nav>
    <details class="mobile-menu"><summary>Menu</summary><nav aria-label="Mobile menu">{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}{% for link in section.settings.menu_right.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}<a href="{{ routes.account_url }}">Account</a></nav></details>
    {% assign storefront_name = settings.site_name | default: shop.name %}
    <a class="wordmark" href="{{ routes.root_url }}" aria-label="{{ storefront_name | escape }} home">
      {% if settings.logo != blank %}{{ settings.logo | image_url: width: 420 | image_tag: class: 'logo', alt: storefront_name }}{% else %}{{ storefront_name }}{% endif %}
    </a>
    <div class="header-tools">
      <nav class="desktop-nav desktop-nav--right" aria-label="About menu">{% for link in section.settings.menu_right.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}</nav>
      <nav class="header-actions" aria-label="Store tools">
        {% if section.settings.show_country_selector and localization.available_countries.size > 1 %}{% form 'localization', class: 'country-selector' %}<label class="visually-hidden" for="Country-{{ section.id }}">Country and currency</label><select id="Country-{{ section.id }}" name="country_code" onchange="this.form.submit()">{% for country in localization.available_countries %}<option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>{{ country.name }} | {{ country.currency.iso_code }}</option>{% endfor %}</select>{% endform %}{% endif %}
        <button class="theme-toggle icon-btn" type="button" data-theme-toggle aria-label="Switch to dark mode"><span aria-hidden="true">&#9680;</span><span data-theme-label class="visually-hidden">Dark mode</span></button><a class="account-link icon-btn" href="{{ routes.account_url }}" aria-label="Account"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8.5" r="3.8"/><path d="M4.5 20c.9-4 3.8-6 7.5-6s6.6 2 7.5 6"/></svg></a><a class="icon-btn" href="{{ routes.search_url }}" data-search-open aria-haspopup="dialog" aria-label="Search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.5 4.5"/></svg></a><a class="icon-btn icon-btn--bag" href="{{ routes.cart_url }}" data-cart-open aria-haspopup="dialog" aria-label="Bag"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5.5 8h13l-1 12h-11l-1-12Z"/><path d="M9 8V6.5a3 3 0 0 1 6 0V8"/></svg><span class="visually-hidden" data-cart-count>({{ cart.item_count }})</span><b class="cart-badge" data-cart-badge{% if cart.item_count == 0 %} hidden{% endif %} aria-hidden="true">{{ cart.item_count }}</b></a>
      </nav>
    </div>
  </div>
</header>
{% schema %}
{"name":"Header","settings":[{"type":"link_list","id":"menu","label":"Left menu","default":"main-menu"},{"type":"link_list","id":"menu_right","label":"Right menu"},{"type":"text","id":"announcement","label":"Announcement bar text","default":"Free shipping on orders over Rs. 2,000 - Easy 15-day returns"},{"type":"url","id":"announcement_link","label":"Announcement bar link"},{"type":"checkbox","id":"show_country_selector","label":"Show country and currency","default":true}]}
{% endschema %}
