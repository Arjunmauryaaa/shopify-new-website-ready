{%- capture short_title -%}{% render 'product-short-title', product: product %}{%- endcapture -%}
{%- assign short_title = short_title | strip -%}
{%- assign current = product.selected_or_first_available_variant -%}
{%- assign guide = section.settings.size_guide_page -%}
<section class="product-detail page-wrap product-page" data-product-section data-product-id="{{ product.id }}">
  <div class="product-gallery" aria-label="{{ short_title | escape }} photos" data-gallery>
    {%- for media in product.media -%}
      {%- assign img_loading = 'lazy' -%}{%- if forloop.first -%}{%- assign img_loading = 'eager' -%}{%- endif -%}
      <div class="gallery-item" data-media-id="{{ media.id }}">
        {%- case media.media_type -%}
          {%- when 'image' -%}
            <button type="button" class="gallery-zoom" data-zoom-src="{{ media | image_url: width: 2400 }}" data-zoom-alt="{{ media.alt | default: short_title | escape }}" aria-label="View image {{ forloop.index }} full screen" aria-haspopup="dialog">
              {{ media | image_url: width: 1800 | image_tag: widths: '500, 800, 1200, 1600, 1800', sizes: '(min-width: 900px) 58vw, 100vw', loading: img_loading, alt: media.alt | default: short_title }}
            </button>
          {%- when 'video' -%}{{ media | video_tag: controls: true, playsinline: true, preload: 'metadata' }}
          {%- when 'external_video' -%}{{ media | external_video_tag }}
        {%- endcase -%}
      </div>
    {%- endfor -%}
  </div>

  <div class="product-info">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">/</span>{% if collection %}<a href="{{ collection.url }}">{{ collection.title | escape }}</a>{% else %}<a href="{{ routes.all_products_collection_url }}">Shop</a>{% endif %}</nav>
    {%- if product.vendor != blank -%}<p class="eyebrow">{{ product.vendor | escape }}</p>{%- endif -%}
    <h1>{{ short_title | escape }}</h1>
    {%- assign compare_price = current.compare_at_price -%}
    {%- if compare_price == blank or compare_price <= current.price -%}
      {%- assign compare_price = current.price | times: 130 | divided_by: 10000 | times: 100 -%}
    {%- endif -%}
    {%- assign save_amount = compare_price | minus: current.price -%}
    {%- assign save_pct = save_amount | times: 100 | divided_by: compare_price | round -%}

    <p class="price">
      <s class="muted" data-product-compare>{{ compare_price | money }}</s>
      <strong data-product-price>{{ current.price | money }}</strong>
      <span class="price-save" data-product-save>Save {{ save_amount | money }} ({{ save_pct }}% OFF)</span>
    </p>

    {%- form 'product', product, class: 'product-form', id: 'ProductForm', data-ajax-cart: '' -%}
      {%- if product.has_only_default_variant -%}
        <input type="hidden" name="id" value="{{ current.id }}" data-variant-id>
      {%- else -%}
        <label class="visually-hidden" for="VariantSelect-{{ section.id }}">Variant</label>
        <select id="VariantSelect-{{ section.id }}" name="id" data-variant-select class="variant-fallback">
          {%- for variant in product.variants -%}
            <option value="{{ variant.id }}"{% if variant == current %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>{{ variant.title | escape }}{% unless variant.available %} - Sold out{% endunless %}</option>
          {%- endfor -%}
        </select>
        {%- for option in product.options_with_values -%}
          {%- assign option_index = forloop.index0 -%}
          <fieldset class="opt-group" data-option="{{ option_index }}">
            <legend class="eyebrow">{{ option.name | escape }}: <span data-option-current>{{ option.selected_value | escape }}</span></legend>
            <div class="opt-values" role="radiogroup" aria-label="{{ option.name | escape }}">
              {%- for value in option.values -%}
                {%- assign opt_variant = null -%}
                {%- for variant in product.variants -%}
                  {%- if variant.options[option_index] == value -%}
                    {%- assign opt_variant = variant -%}
                    {%- break -%}
                  {%- endif -%}
                {%- endfor -%}
                {%- assign opt_compare = opt_variant.compare_at_price -%}
                {%- if opt_compare == blank or opt_compare <= opt_variant.price -%}
                  {%- assign opt_compare = opt_variant.price | times: 130 | divided_by: 10000 | times: 100 -%}
                {%- endif -%}
                <label class="opt{% if value.swatch.color %} opt--swatch{% endif %}">
                  <input type="radio" name="option-{{ option_index }}" value="{{ value | escape }}"{% if value.selected %} checked{% endif %} data-option-value>
                  {%- if value.swatch.color -%}<span class="swatch" style="background:{{ value.swatch.color }}" aria-hidden="true"></span>{%- endif -%}
                  <span class="opt__name">{{ value | escape }}</span>
                  {%- if opt_variant != null -%}
                    <span class="opt__price" data-opt-price>
                      <s class="opt__cut">{{ opt_compare | money }}</s>
                      <span>{{ opt_variant.price | money }}</span>
                    </span>
                  {%- endif -%}
                </label>
              {%- endfor -%}
            </div>
          </fieldset>
        {%- endfor -%}
        {%- if guide != blank -%}<button type="button" class="text-btn size-guide-btn" data-size-guide-open aria-haspopup="dialog">Size guide</button>{%- endif -%}
      {%- endif -%}

      <div class="product-qty-row">
        <label for="Quantity-{{ section.id }}" style="margin:0">Quantity</label>
        <span class="product-qty-subtotal" data-product-subtotal-wrap>
          <span class="muted">Total: </span><strong data-product-subtotal>{{ current.price | money }}</strong>
        </span>
      </div>
      <input id="Quantity-{{ section.id }}" type="number" name="quantity" value="1" min="1" max="10" inputmode="numeric" data-qty-input>
      <p class="form-error" role="alert" data-product-error></p>
      <div class="product-purchase-actions">
        <button class="button button-dark" type="submit" name="add" data-add-button{% unless current.available %} disabled{% endunless %}>
          <span data-add-label>{% if current.available %}Add to bag{% else %}Sold out{% endif %}</span>
          <span data-add-price>&nbsp;&bull;&nbsp;{{ current.price | money }}</span>
        </button>
        {%- if section.settings.show_express_checkout -%}<div class="product-express">{{ form | payment_button }}</div>{%- endif -%}
        {%- if section.settings.show_express_page_link -%}
          <a href="{{ product.url }}?view=express" class="button button-outline" style="text-align:center;width:100%;display:flex;align-items:center;justify-content:center">
            {{ section.settings.express_page_label | default: 'Buy now & see recommendations' | escape }}
          </a>
        {%- endif -%}
      </div>
    {%- endform -%}

    <ul class="pdp-assure" aria-label="Our promises">
      <li><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10.5" width="14" height="9.5" rx="2"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/></svg>Secure payment</li>
      <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.6-5.9M4 4.5v4h4"/></svg>Easy returns</li>
      <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6.5h11v9H3zM14 10h4l3 3v2.5h-7z"/><circle cx="7.5" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>Tracked delivery</li>
    </ul>
    <div class="product-promise">
      <span>Checkout powered by Shopify</span>
      {%- if settings.delivery_note != blank -%}<span>{{ settings.delivery_note | escape }}</span>{%- else -%}<span>Shipping options shown at checkout</span>{%- endif -%}
    </div>
    <div class="product-accordions">
      {%- if product.description != blank -%}<details open><summary>Details &amp; how to use</summary><div class="product-accordion-content rte">{{ product.description }}</div></details>{%- endif -%}
      <details><summary>Shipping &amp; returns</summary><div class="product-accordion-content">Review the <a href="/policies/shipping-policy">shipping policy</a> and <a href="/policies/refund-policy">refund policy</a> before ordering.</div></details>
    </div>
    <p class="product-payment-note">Fast payment options appear when enabled in your Shopify payment settings.</p>
  </div>

  <div class="product-more" data-recommendations data-url="{{ routes.product_recommendations_url }}?product_id={{ product.id }}&limit=4&section_id=product-recommendations&intent=related"></div>

  <div class="sticky-atc" data-sticky-atc hidden>
    <span class="sticky-atc__thumb" aria-hidden="true">{% if product.featured_image %}{{ product.featured_image | image_url: width: 120 | image_tag: width: 40, alt: '' }}{% endif %}</span>
    <span class="sticky-atc__info"><span class="sticky-atc__title">{{ short_title | escape }}</span><span class="muted" data-sticky-price>{{ current.price | money }}</span></span>
    <button class="button button-dark" type="button" data-sticky-add{% unless current.available %} disabled{% endunless %}>{% if current.available %}Add to bag{% else %}Sold out{% endif %}</button>
  </div>
</section>

<dialog class="zoom-dialog" data-zoom-dialog aria-label="Image viewer">
  <button class="icon-close zoom-dialog__close" type="button" data-dialog-close aria-label="Close image viewer">&times;</button>
  <div class="zoom-stage" data-zoom-stage><img alt="" width="1600" height="2000" data-zoom-img></div>
  <div class="zoom-controls" role="group" aria-label="Zoom">
    <button type="button" data-zoom-out aria-label="Zoom out">&minus;</button><output data-zoom-level>100%</output><button type="button" data-zoom-in aria-label="Zoom in">+</button>
  </div>
</dialog>

{%- if guide != blank -%}
  <dialog class="size-dialog" data-size-guide-dialog aria-label="{{ guide.title | escape }}">
    <div class="size-dialog__panel">
      <header><h2 class="eyebrow">{{ guide.title | escape }}</h2><button class="icon-close" type="button" data-dialog-close aria-label="Close size guide">&times;</button></header>
      <div class="rte">{{ guide.content }}</div>
    </div>
  </dialog>
{%- endif -%}

<script type="application/json" data-product-json>
  {
    "variants": [
      {%- for variant in product.variants -%}
        {%- assign v_compare = variant.compare_at_price -%}
        {%- if v_compare == blank or v_compare <= variant.price -%}
          {%- assign v_compare = variant.price | times: 130 | divided_by: 10000 | times: 100 -%}
        {%- endif -%}
        {%- assign v_save_amt = v_compare | minus: variant.price -%}
        {%- assign v_save_pct = v_save_amt | times: 100 | divided_by: v_compare | round -%}
        {"id": {{ variant.id }}, "options": {{ variant.options | json }}, "available": {{ variant.available | json }}, "price": {{ variant.price | money | json }}, "priceCents": {{ variant.price }}, "compare": {{ v_compare | money | json }}, "compareCents": {{ v_compare }}, "saveAmount": {{ v_save_amt | money | json }}, "savePct": {{ v_save_pct }}, "mediaId": {% if variant.featured_media %}{{ variant.featured_media.id }}{% else %}null{% endif %}}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>
<script type="application/ld+json">{{ product | structured_data }}</script>
{% schema %}
{
  "name": "Product details",
  "settings": [
    { "type": "checkbox", "id": "show_express_checkout", "label": "Show accelerated checkout button", "default": true },
    { "type": "checkbox", "id": "show_express_page_link", "label": "Show 'Instant checkout with recommendations' button", "default": false },
    { "type": "text", "id": "express_page_label", "label": "Instant checkout button label", "default": "Buy now & add recommendations" },
    { "type": "page", "id": "size_guide_page", "label": "Size guide page", "info": "Pick a page that holds your size or age chart. A Size guide button appears when one is chosen." }
  ]
}
{% endschema %}
