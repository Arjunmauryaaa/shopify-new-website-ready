{% assign fallback_images = 'es-waffle-knit.jpg,es-pointelle-white.jpg,es-lace-beanie.jpg,es-shelf-camera.jpg' | split: ',' %}
<section class="section-wrap category-tiles">
  <div class="section-heading"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.title | escape }}</h2></div></div>
  <div class="category-tiles__grid">
    {% for block in section.blocks %}
      {% assign col = block.settings.collection %}
      {% assign tile_image = block.settings.image | default: col.image %}
      {% assign tile_title = block.settings.title | default: col.title %}
      {% assign fallback = fallback_images[forloop.index0] | default: fallback_images[0] %}
      <a class="category-tile" href="{{ col.url | default: block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
        {% if tile_image != blank %}{{ tile_image | image_url: width: 900 | image_tag: widths: '360, 540, 900', sizes: '(min-width: 900px) 24vw, 46vw', loading: 'lazy', alt: tile_title }}
        {% else %}<img src="{{ fallback | asset_url }}" width="900" height="1100" alt="{{ tile_title | escape }}" loading="lazy">{% endif %}
        <span class="category-tile__label"><span>{{ tile_title | escape }}</span><span aria-hidden="true">&rarr;</span></span>
      </a>
    {% endfor %}
  </div>
</section>
{% schema %}{"name":"Shop by category","max_blocks":6,"settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Browse"},{"type":"text","id":"title","label":"Title","default":"Shop by category"}],"blocks":[{"type":"tile","name":"Category","settings":[{"type":"collection","id":"collection","label":"Collection"},{"type":"text","id":"title","label":"Title override"},{"type":"image_picker","id":"image","label":"Image override"},{"type":"url","id":"link","label":"Link (when no collection)"}]}],"presets":[{"name":"Shop by category"}]}
{% endschema %}
