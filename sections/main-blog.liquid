<section class="page-wrap"><header class="page-heading"><p class="eyebrow">Journal</p><h1>{{ blog.title | escape }}</h1></header>{% paginate blog.articles by 12 %}<div class="article-grid">{% for article in blog.articles %}<article>{% if article.image %}<a href="{{ article.url }}">{{ article.image | image_url: width: 1000 | image_tag: widths: '400, 700, 1000', loading: 'lazy', alt: article.image.alt | default: article.title }}</a>{% endif %}<p class="eyebrow">{{ article.published_at | time_tag: format: 'date' }}</p><h2><a href="{{ article.url }}">{{ article.title | escape }}</a></h2><p>{{ article.excerpt_or_content | strip_html | truncate: 160 }}</p></article>{% endfor %}</div>{% if paginate.pages > 1 %}<nav class="pagination">{{ paginate | default_pagination }}</nav>{% endif %}{% endpaginate %}</section>
{% schema %}{"name":"Blog articles","settings":[]}{% endschema %}
