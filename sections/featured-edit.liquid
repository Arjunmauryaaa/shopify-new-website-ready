{% assign featured_collection = collections[section.settings.collection] %}{% if featured_collection == blank or featured_collection.products_count == 0 %}{% assign featured_collection = collections.all %}{% endif %}
{% assign featured_image = section.settings.image | default: featured_collection.image | default: featured_collection.products.first.featured_image %}
<section class="featured-edit">
  <a class="featured-edit__image" href="{{ featured_collection.url | default: routes.all_products_collection_url }}">{% if featured_image %}{{ featured_image | image_url: width: 1200 | image_tag: widths: '500, 800, 1200', sizes: '(min-width: 900px) 42vw, 100vw', loading: 'lazy', alt: featured_collection.title }}{% else %}<span class="campaign-placeholder">Collection image</span>{% endif %}</a>
  <div class="featured-edit__body"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.title | default: featured_collection.title | escape }}</h2>{% if section.settings.body != blank %}<p>{{ section.settings.body | escape }}</p>{% elsif featured_collection.description != blank %}<p>{{ featured_collection.description | strip_html | truncate: 180 }}</p>{% endif %}<div class="featured-edit__products">{% for product in featured_collection.products limit: 2 %}{% render 'product-card', product: product %}{% endfor %}</div><a class="text-link" href="{{ featured_collection.url | default: routes.all_products_collection_url }}">{{ section.settings.link_label | escape }}</a></div>
</section>
{% schema %}{"name":"Featured collection edit","settings":[{"type":"collection","id":"collection","label":"Collection"},{"type":"image_picker","id":"image","label":"Editorial image override"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Featured collection"},{"type":"text","id":"title","label":"Title","default":"The Edit"},{"type":"textarea","id":"body","label":"Text","default":"A curated selection from the collection."},{"type":"text","id":"link_label","label":"Link label","default":"Shop the collection"}]}
{% endschema %}
