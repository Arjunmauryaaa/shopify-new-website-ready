<section class="page-wrap"><header class="page-heading"><p class="eyebrow">Explore</p><h1>Collections</h1></header><div class="collection-list">{% for collection in collections %}{% unless collection.handle == 'frontpage' %}<a href="{{ collection.url }}" class="collection-card">{% if collection.featured_image %}{{ collection.featured_image | image_url: width: 1000 | image_tag: widths: '400, 700, 1000', loading: 'lazy', alt: collection.title }}{% else %}<span class="image-placeholder"></span>{% endif %}<h2>{{ collection.title | escape }}</h2><span class="muted">{{ collection.products_count }} pieces</span></a>{% endunless %}{% endfor %}</div></section>
{% schema %}{"name":"Collection list","settings":[]}{% endschema %}
