{%- assign tints = '#e6dccb,#ecd9cd,#dfe6dc,#d9ded6,#e9e0cf,#e3e9df' | split: ',' -%}
<section class="section-wrap wn">
  <div class="section-heading"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.title | escape }}</h2></div></div>
  <div class="wn__grid">
    {%- for block in section.blocks -%}
      {%- assign col = block.settings.collection -%}
      {%- assign tile_title = block.settings.title | default: col.title -%}
      {%- assign tint_index = forloop.index0 | modulo: 6 -%}
      <a class="wn__tile" style="--tile:{{ tints[tint_index] }}" href="{{ col.url | default: block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
        <span class="wn__icon">
          {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 240 | image_tag: width: 68, height: 68, loading: 'lazy', alt: '' }}
          {%- else -%}
          <svg viewBox="0 0 24 24" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'skin' -%}<path d="M12 3c3 3.6 5 6.4 5 9a5 5 0 0 1-10 0c0-2.6 2-5.4 5-9Z"/><path d="M9.8 13.2a2.4 2.4 0 0 0 2.2 1.6"/>
              {%- when 'hair' -%}<path d="M7 20c0-6 1-11 5-16 4 5 5 10 5 16"/><path d="M12 8v12M9.5 13l2.5 2 2.5-2"/>
              {%- when 'immunity' -%}<path d="M12 3 5 6v5.5c0 4.4 3 7.5 7 9.5 4-2 7-5.1 7-9.5V6l-7-3Z"/><path d="m9 12 2 2 4-4.5"/>
              {%- when 'sleep' -%}<path d="M19 14.5A7.5 7.5 0 0 1 9.5 5a7.5 7.5 0 1 0 9.5 9.5Z"/>
              {%- when 'oral' -%}<path d="M7 4c-2.4 0-3.5 2-3.5 4.2 0 2.6 1.4 3.8 1.9 6.3.4 2.2.9 5.5 2.4 5.5 1.3 0 1.4-3 2.2-4.2.5-.8 1.4-.8 1.9 0 .8 1.2.9 4.2 2.2 4.2 1.5 0 2-3.3 2.4-5.5.5-2.5 1.9-3.7 1.9-6.3C20.5 6 19.4 4 17 4c-1.7 0-2.6.8-5 .8S8.7 4 7 4Z"/>
              {%- when 'body' -%}<circle cx="12" cy="5.5" r="2.5"/><path d="M6.5 20v-5.5c0-2.5 1.5-4 5.5-4s5.5 1.5 5.5 4V20M9.5 20v-3.5M14.5 20v-3.5"/>
              {%- when 'fitness' -%}<path d="M3 10v4M6 8v8M18 8v8M21 10v4M6 12h12"/>
              {%- when 'firstaid' -%}<rect x="4" y="7" width="16" height="12" rx="3"/><path d="M9 7V5.5A1.5 1.5 0 0 1 10.5 4h3A1.5 1.5 0 0 1 15 5.5V7M12 10.5v5M9.5 13h5"/>
              {%- when 'eye' -%}<path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12Z"/><circle cx="12" cy="12" r="2.8"/>
              {%- else -%}<path d="M12 20s-7.5-4.6-7.5-10A4.3 4.3 0 0 1 12 7.4 4.3 4.3 0 0 1 19.5 10c0 5.4-7.5 10-7.5 10Z"/>
            {%- endcase -%}
          </svg>
          {%- endif -%}
        </span>
        <span class="wn__title">{{ tile_title | escape }}{% if block.settings.subtitle != blank %}<span class="wn__sub">{{ block.settings.subtitle | escape }}</span>{% endif %}</span>
      </a>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Shop by need",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Find what you need" },
    { "type": "text", "id": "title", "label": "Title", "default": "Shop by need" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Need",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Skin care" },
        { "type": "text", "id": "subtitle", "label": "Short line (optional)" },
        { "type": "select", "id": "icon", "label": "Icon", "default": "skin", "options": [
          { "value": "skin", "label": "Skin" }, { "value": "hair", "label": "Hair" }, { "value": "immunity", "label": "Immunity" }, { "value": "sleep", "label": "Sleep" },
          { "value": "oral", "label": "Oral care" }, { "value": "body", "label": "Body care" }, { "value": "fitness", "label": "Fitness" }, { "value": "firstaid", "label": "First aid" },
          { "value": "eye", "label": "Eye care" }, { "value": "heart", "label": "Heart / general" }
        ] },
        { "type": "image_picker", "id": "image", "label": "Round photo (replaces icon)" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "url", "id": "link", "label": "Link (when no collection)" }
      ]
    }
  ],
  "presets": [{ "name": "Shop by need" }]
}
{% endschema %}
