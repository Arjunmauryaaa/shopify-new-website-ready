<section class="campaign-video" aria-label="{{ section.settings.heading | escape }}">
  <div class="campaign-video__frame">
    {% if section.settings.video != blank %}
      {{ section.settings.video | video_tag: controls: true, muted: true, playsinline: true, preload: 'metadata' }}
    {% else %}
      <video controls playsinline preload="metadata" poster="{{ 'es-pointelle-white.jpg' | asset_url }}" aria-label="{{ section.settings.heading | escape }}">
        <source src="{{ 'campaign-baby-clothes-video.mp4' | asset_url }}" type="video/mp4">
        Your browser does not support the video element.
      </video>
    {% endif %}
  </div>
  <div class="campaign-video__copy"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.body | escape }}</p></div>
</section>
{% schema %}{"name":"Campaign video","settings":[{"type":"video","id":"video","label":"Replace the included video"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"A little more about us"},{"type":"text","id":"heading","label":"Heading","default":"Small things, thoughtfully chosen."},{"type":"textarea","id":"body","label":"Text","default":"See the care and calm behind every little detail."}]}
{% endschema %}
