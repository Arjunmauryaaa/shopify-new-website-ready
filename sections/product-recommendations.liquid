{%- comment -%} Loaded by assets/enhance.js through the Section Rendering API (product_recommendations_url). {%- endcomment -%}
{%- if recommendations.performed and recommendations.products_count > 0 -%}
  <section class="recs" aria-labelledby="RecsHeading">
    <div class="section-heading"><h2 id="RecsHeading">You may also like</h2></div>
    <div class="product-grid">
      {%- for item in recommendations.products -%}{% render 'product-card', product: item %}{%- endfor -%}
    </div>
  </section>
{%- endif -%}
{% schema %}
{"name":"Product recommendations","settings":[]}
{% endschema %}
