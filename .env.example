# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=EAST SIDE
# Fallback market slug from src/config/markets.ts when the visitor cannot be located
NEXT_PUBLIC_DEFAULT_MARKET=en-in
# Set true to make a missing production config a hard startup error
STRICT_ENV=false

# ---------- Shopify Storefront API (server-side only) ----------
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# public = X-Shopify-Storefront-Access-Token header, private = Shopify-Storefront-Private-Token header
SHOPIFY_STOREFRONT_TOKEN_TYPE=public
SHOPIFY_API_VERSION=2026-07
# Default buyer country for pricing/availability (ISO 3166-1 alpha-2)
SHOPIFY_DEFAULT_COUNTRY=IN
# Shopify-hosted customer accounts URL (Settings > Customer accounts), e.g. https://shopify.com/<shop-id>/account
SHOPIFY_CUSTOMER_ACCOUNT_URL=
# Optional: secret for POST /api/revalidate (on-demand cache refresh from Shopify webhooks/Flow)
REVALIDATE_SECRET=

# ---------- Razorpay ----------
# Chosen architecture: Shopify-hosted checkout with Razorpay enabled as a payment provider in
# Shopify admin. The storefront never handles card data or Razorpay secrets, so NO Razorpay
# variables are read by this codebase. Configure Razorpay inside Shopify admin (Settings > Payments).
# The variables below are reserved ONLY if you approve the custom-checkout alternative (docs/PAYMENTS.md).
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# ---------- Newsletter (Klaviyo) ----------
KLAVIYO_PRIVATE_API_KEY=
KLAVIYO_LIST_ID=

# ---------- Contact form (Resend) ----------
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# ---------- Conversion features (all optional; each is hidden until configured) ----------
# Free-shipping progress bar: thresholds per currency. MUST match your real Shopify shipping rates.
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLDS={"INR":5000,"USD":75}
# Real payment methods enabled in Shopify, shown as text near checkout
NEXT_PUBLIC_PAYMENT_METHODS=UPI, Cards, Netbanking
NEXT_PUBLIC_DELIVERY_ESTIMATE=
# Variant id (gid://shopify/ProductVariant/123) of a "Gift wrap" product
NEXT_PUBLIC_GIFT_WRAP_VARIANT_ID=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_INSTAGRAM_HANDLE=
# "Only N left" needs the unauthenticated_read_product_inventory Storefront scope
SHOPIFY_INVENTORY_ENABLED=false

# Analytics (scripts load only after the visitor accepts the cookie banner)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_KLAVIYO_COMPANY_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Reviews (Judge.me) — real reviews only
JUDGEME_API_TOKEN=
JUDGEME_SHOP_DOMAIN=

# Atelier (private client list) — second Klaviyo list
KLAVIYO_ATELIER_LIST_ID=
